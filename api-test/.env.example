# Copy this file to .env (same folder) and fill in your values.
# .env is gitignored — never commit the real token.

# From Qualtrics: avatar (top right) -> Account Settings -> Qualtrics IDs -> "API" box
QUALTRICS_API_TOKEN=

# From the "User" box on the same page, e.g. ca1, iad1, eu
QUALTRICS_DATACENTER=

# The SV_ id of the survey to modify (run 01_whoami.py to list your surveys)
QUALTRICS_SURVEY_ID=

# Optional: force a specific library for uploads (otherwise 01_whoami.py
# auto-discovers your personal UR_ library and saves it to library_id.txt)
QUALTRICS_LIBRARY_ID=
